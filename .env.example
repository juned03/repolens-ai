# Required — OpenAI API key for LLM and embedding requests
OPENAI_API_KEY=

# Qdrant vector database URL (default: http://localhost:6333)
QDRANT_URL=http://localhost:6333

# SQLite database file path (default: ./data/repolens.db)
DATABASE_URL=./data/repolens.db

# Local directory for extracted repository files (default: ./data)
DATA_DIR=./data

# Maximum ZIP upload size in megabytes (default: 50)
MAX_UPLOAD_SIZE_MB=50

# Maximum number of source files indexed per repository (default: 500)
MAX_FILES_PER_REPO=500
